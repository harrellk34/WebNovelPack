<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebNovelPack.App.MainWindow"
        Title="WebNovelPack"
        Width="900"
        Height="600">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Name="ImportFolderButton"
                    Content="Import Chapter Folder"
                    Click="ImportFolderButton_Click" />

            <TextBlock Name="StatusText"
                       VerticalAlignment="Center"
                       Text="No folder imported yet." />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,*"
              Margin="0,16,0,0"
              ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Chapters"
                           FontWeight="SemiBold" />
                <ListBox Name="ChapterList" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Warnings"
                           FontWeight="SemiBold" />
                <ListBox Name="WarningsList" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
