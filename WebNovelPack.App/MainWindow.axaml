<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebNovelPack.App.MainWindow"
        Title="WebNovelPack"
        Width="900"
        Height="600">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Name="ImportFolderButton"
                        Content="Import Chapter Folder"
                        Click="ImportFolderButton_Click" />

                <Button Name="ExportEpubButton"
                        Content="Export EPUB"
                        Click="ExportEpubButton_Click"
                        IsEnabled="False" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Name="StatusText"
                           VerticalAlignment="Center"
                           Text="No folder imported yet."
                           TextWrapping="Wrap" />
                <TextBlock Name="ExportStatusText"
                           VerticalAlignment="Center"
                           Text=""
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="8">
            <TextBlock Text="Book Metadata"
                       FontWeight="SemiBold" />

            <Grid ColumnDefinitions="Auto,*,Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Title" />
                <TextBox Name="TitleTextBox"
                         Grid.Row="0"
                         Grid.Column="1" />

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Author" />
                <TextBox Name="AuthorTextBox"
                         Grid.Row="0"
                         Grid.Column="3" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Language" />
                <TextBox Name="LanguageTextBox"
                         Grid.Row="1"
                         Grid.Column="1" />

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Identifier" />
                <TextBox Name="IdentifierTextBox"
                         Grid.Row="1"
                         Grid.Column="3" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Top"
                           Text="Description" />
                <TextBox Name="DescriptionTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         MinHeight="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />

                <Button Name="SaveMetadataButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        Content="Save Metadata"
                        Click="SaveMetadataButton_Click" />
                <TextBlock Name="MetadataStatusText"
                           Grid.Row="3"
                           Grid.Column="2"
                           Grid.ColumnSpan="2"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="2*,*,*"
              Margin="0,16,0,0"
              ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Import Preview"
                           FontWeight="SemiBold" />
                <ListBox Name="ChapterList" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Skipped Files"
                           FontWeight="SemiBold" />
                <ListBox Name="SkippedFilesList" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="Warnings"
                           FontWeight="SemiBold" />
                <ListBox Name="WarningsList" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
